#!/usr/bin/env python3
from __future__ import annotations

import sys
from pathlib import Path

import quickjs


def _show_help() -> None:
    print("QuickJS-ng version 0.16.0")
    print("usage: qjs --script FILE")


def _run_script(script_path: str) -> None:
    source = Path(script_path).read_text(encoding="utf-8")
    context = quickjs.Context()
    context.add_callable("__python_stdout", lambda value: print(value, flush=True))
    context.eval(
        """
        globalThis.console = {
          log: (...values) => __python_stdout(values.map(value =>
            typeof value === 'string' ? value : JSON.stringify(value)).join(' ')),
        };
        """
    )
    context.eval(source)
    while context.execute_pending_job():
        pass


def main() -> int:
    if "--help" in sys.argv or len(sys.argv) == 1:
        _show_help()
        return 0

    try:
        script_index = sys.argv.index("--script")
        script_path = sys.argv[script_index + 1]
    except (ValueError, IndexError):
        print("qjs: expected --script FILE", file=sys.stderr)
        return 2

    try:
        _run_script(script_path)
    except Exception as error:
        print(f"qjs: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
