# Public hostname handled by Caddy. Keep this value unless the domain changes.
RESOLVER_DOMAIN=video.piloton.cc

# Optional fixed ISP proxy for extraction requests. Never commit the real
# username or password. Example:
# YOUTUBE_PROXY_URL=http://username:password@proxy.example:12345
YOUTUBE_PROXY_URL=

# Optional Japan ISP proxy used only for TVer and ABEMA. Their extraction,
# manifests, encryption keys, video, and audio all use this same route.
# JAPAN_PROXY_URL=http://username:password@jp-proxy.example:12345
JAPAN_PROXY_URL=

# Conservative defaults for a small VPS.
CACHE_SECONDS=180
EDGE_CACHE_SECONDS=180
STREAM_EDGE_CACHE_SECONDS=20
RATE_LIMIT=12
RATE_WINDOW_SECONDS=60
MAX_CONCURRENT_EXTRACTS=2
PLAYER_CLIENTS=web_embedded,mweb,android_vr
PLAYER_TEST_PREVIEW_SECONDS=12

# Keep long ABEMA programs playable and retry brief Japan-proxy interruptions.
ABEMA_TOKEN_SECONDS=14400
STREAM_RESOURCE_ATTEMPTS=3
