{$RESOLVER_DOMAIN} {
  encode zstd gzip

  header {
    X-Content-Type-Options nosniff
    Referrer-Policy no-referrer
    Permissions-Policy "camera=(), microphone=(), geolocation=()"
    -Server
  }

  reverse_proxy resolver:8000 {
    # Send live media to VRChat as soon as it arrives instead of waiting for a
    # response buffer to fill.
    flush_interval -1
  }
}
